# Copy to backend/.env and fill in as needed. Everything is optional for local
# boot — the service runs with no AI key (rule-based) and no auth (analytics
# endpoints are public compute).

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Supabase auth (Phase 0c) — needed to protect user endpoints.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_JWT_SECRET=

# AI gateway (OpenRouter). Without a key the gateway uses rule-based mode.
# OPENROUTER_API_KEY=
# Free models are tried first, then fallbacks (comma-separated).
# AI_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat:free
# AI_FALLBACK_MODELS=
