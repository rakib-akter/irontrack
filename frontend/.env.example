# Copy this file to ".env" and fill in real values.

# --- Database (Supabase Postgres) ---
# In your Supabase project: Settings → Database → Connection string.
# DATABASE_URL uses the pooled connection (port 6543, ?pgbouncer=true).
# DIRECT_URL uses the direct connection (port 5432) and is used for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Used to sign legacy session cookies. Generate one with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- Supabase Auth (Phase 0c migration) ---
# Supabase dashboard → Settings → API. The anon key is safe to expose (it ships
# to the browser and is gated by RLS). Never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# --- AI (optional) ---
# The app works fully without this (rule-based). Add a FREE OpenRouter key to
# enable the LLM "Coach's note" (grounded in the research library). Free models
# cost $0. Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=""
# Optional overrides (comma-separated). Defaults to free Llama/DeepSeek/Qwen.
# OPENROUTER_MODELS="meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat:free"
# OPENROUTER_FALLBACK_MODELS=""
