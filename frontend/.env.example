# Copy this file to ".env" and fill in real values.

# --- Database (Supabase Postgres) ---
# In your Supabase project: Settings → Database → Connection string.
# DATABASE_URL uses the pooled connection (port 6543, ?pgbouncer=true).
# DIRECT_URL uses the direct connection (port 5432) and is used for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth ---
# Used to sign session cookies. Generate one with:  openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# --- AI coaching (optional, not used yet) ---
# The app ships with a built-in rule-based coach and needs no key.
# When you wire up a real LLM, set the provider + key here.
# AI_PROVIDER="claude"
# ANTHROPIC_API_KEY=""
